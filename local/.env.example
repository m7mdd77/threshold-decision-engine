# Server-only credentials. Never put this key in browser JavaScript or paste it into chat.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_API_FORMAT=openai
AGENTROUTER_MODEL=gpt-6.1-sol
# Uses the actual installed client supported by AgentRouter; tools and MCP are disabled.
AGENTROUTER_TRANSPORT=codex
CODEX_PATH=codex.exe
